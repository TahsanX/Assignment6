NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Supabase Postgres (pooled for runtime, direct for migrations)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=
EMAIL_FROM=CodeAssess <onboarding@resend.dev>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_CURRENCY=usd
PRICE_PER_CANDIDATE_SLOT=2

# Seeded demo admin
ADMIN_EMAIL=admin@codeassess.dev
ADMIN_PASSWORD=ChangeMe123!

# Return invitation tokens in the invite response even in production (demo only)
EXPOSE_INVITE_TOKENS=false
