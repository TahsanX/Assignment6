generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  COMPANY
  CANDIDATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProblemType {
  MCQ
  WRITTEN
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id        String     @id @default(uuid())
  clerkId   String     @unique
  email     String     @unique
  name      String
  role      Role?
  status    UserStatus @default(ACTIVE)
  onboarded Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  companyProfile   CompanyProfile?
  candidateProfile CandidateProfile?
  problems         Problem[]
  assessments      Assessment[]
  attempts         Attempt[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  invitations      Invitation[]

  @@index([role, status])
  @@index([deletedAt])
}

model CompanyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  website     String?
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  headline  String?
  skills    String[]
  github    String?
  resumeUrl String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Problem {
  id            String      @id @default(uuid())
  companyId     String
  type          ProblemType
  title         String
  body          String
  difficulty    Difficulty  @default(MEDIUM)
  tags          String[]
  points        Int         @default(10)
  options       Json? // MCQ: [{ id, text }]
  correctAnswer Json? // MCQ: array of option ids
  testCases     Json? // CODING: rubric / sample test cases
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  company     User                @relation(fields: [companyId], references: [id])
  assessments AssessmentProblem[]
  answers     Answer[]

  @@index([companyId, type, difficulty])
  @@index([tags], type: Gin)
  @@index([deletedAt])
}

enum AssessmentStatus {
  DRAFT
  PENDING_PAYMENT
  PUBLISHED
  CLOSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  EVALUATED
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Assessment {
  id              String           @id @default(uuid())
  companyId       String
  title           String
  description     String?
  durationMins    Int
  passMarks       Int              @default(0)
  status          AssessmentStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  candidateSlots  Int              @default(10)
  maxAttempts     Int              @default(1)
  resultsReleased Boolean          @default(false)
  moderationNote  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  company     User                @relation(fields: [companyId], references: [id])
  problems    AssessmentProblem[]
  invitations Invitation[]
  attempts    Attempt[]
  payments    Payment[]

  @@index([companyId, status])
  @@index([status, deletedAt])
  @@index([title])
}

model AssessmentProblem {
  id           String @id @default(uuid())
  assessmentId String
  problemId    String
  order        Int    @default(0)
  points       Int

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id])

  @@unique([assessmentId, problemId])
  @@index([assessmentId, order])
}

model Invitation {
  id           String           @id @default(uuid())
  assessmentId String
  email        String
  candidateId  String?
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate  User?      @relation(fields: [candidateId], references: [id])

  @@unique([assessmentId, email])
  @@index([email])
  @@index([candidateId, status])
}

model Attempt {
  id           String        @id @default(uuid())
  assessmentId String
  candidateId  String
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  deadlineAt   DateTime
  submittedAt  DateTime?
  score        Int?
  totalPoints  Int?
  passed       Boolean?
  seed         Int           @default(0)
  events       Json          @default("[]")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  candidate  User       @relation(fields: [candidateId], references: [id])
  answers    Answer[]

  @@index([assessmentId, status])
  @@index([candidateId, status])
  @@index([assessmentId, score])
}

model Answer {
  id          String   @id @default(uuid())
  attemptId   String
  problemId   String
  response    Json?
  autoScore   Int?
  manualScore Int?
  feedback    String?
  evaluatorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([attemptId, problemId])
}

model Payment {
  id              String        @id @default(uuid())
  companyId       String
  assessmentId    String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("usd")
  status          PaymentStatus @default(INITIATED)
  invoiceNumber   String        @unique
  stripeSessionId String?       @unique
  paymentIntentId String?
  payerReference  String?
  statusMessage   String?
  rawResponse     Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company    User       @relation(fields: [companyId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([companyId, status])
  @@index([assessmentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([action])
}
